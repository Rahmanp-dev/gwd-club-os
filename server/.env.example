# Copy to .env. Do not commit .env or put this value in the Flutter app.
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=mehnat_founder_os
PORT=3000
JWT_SECRET=replace-with-a-long-random-server-secret
# Required to register the three initial founder accounts. Keep this private,
# then remove it after all three accounts exist.
FOUNDER_INVITE_CODE=replace-with-a-private-founder-invite-code
# JWT lifetime, for example 12h or 7d.
JWT_EXPIRES_IN=12h
# For local Flutter development. Use your deployed app domain in production.
CLIENT_ORIGIN=*
